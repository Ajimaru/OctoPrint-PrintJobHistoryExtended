            <!-- EXPORT / IMPORT - TAB -->
            <div class="tab-pane" id="tab-pjhe-Export-Import">
                <h3>Export</h3>
                <div class="control-group">
                    <div class="controls">
                        <span><b>Print Job History Extended Database</b>: Export all data as <a href="#" data-bind="attr: {href: $root.exportUrl('CSV'), css: {disabled: !$root.exportUrl('CSV')}}">CSV-File</a></span>
                    </div>
                </div>
                <div class="control-group" data-bind="visible: isPrintHistoryPluginAvailable">
                    <div class="controls">
                        <span><b>Legacy: Print History Database</b>: Export all data as <a href="#" data-bind="attr: {href: $root.exportUrl('legacyPrintHistory'), css: {disabled: !$root.exportUrl('legacyPrintHistory')}}">CSV-File</a></span>
                    </div>
                </div>
<!--                <div class="control-group">-->
<!--                    <div class="controls">-->
<!--                        <span><b>TODO Metadata.json</b>: OctoPrint use metadata.json files (location: upload-(sub)folders) to store all past print jobs. Export it as <a href="#" data-bind="attr: {href: $root.exportUrl('CSV'), css: {disabled: !$root.exportUrl('CSV')}}">CSV-File</a></span>-->
<!--                    </div>-->
<!--                </div>-->
<!--                <div class="control-group">-->
<!--                    <div class="controls">-->
<!--                        <span><b>TODO PrintHistory-Plugin</b>: Export all data from plugin as <a href="#" data-bind="attr: {href: $root.exportUrl('CSV'), css: {disabled: !$root.exportUrl('CSV')}}">CSV-File</a></span>-->
<!--                    </div>-->
<!--                </div>-->
                <h3>Import</h3>

                <div class="control-group">
                    <div class="controls">
                        <div class="row">
                            Import a CSV-File to the Print Job History Extended database.
                        </div>
                        <br/>
                        <div class="row">
                            <div class="span6">
                                <label class="radio">
                                    <input type="radio" name="importCSVMode" value="replace" data-bind="checked: pluginSettings.importCSVMode"> Replace current database
                                </label>
                                <label class="radio">
                                        <input type="radio" name="importCSVMode" value="append" data-bind="checked: pluginSettings.importCSVMode"> Append to database
                                </label>
                            </div>

                            <div class="span6">
                                <div class="input-prepend">
                                    <span class="btn fileinput-button">
                                        <span>Browse...</span>
                                        <input id="settings-pjhe-importcsv-upload"
                                               type="file"
                                               name="file"
                                               data-url="/plugin/PrintJobHistoryExtended/importCSV"
                                               accept=".csv">
                                    </span>
                                    <span class="add-on" data-bind="text: csvFileUploadName"></span>
                                </div>
                                <button class="btn btn-primary"
                                        data-bind="disable: (csvImportInProgress() || csvFileUploadName() == undefined), click: performCSVImportFromUpload">
                                    <i class="fa fa-spinner fa-spin"
                                       data-bind="visible: csvImportInProgress"></i> Upload & import
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="control-group">
                    <div class="controls">
                        <div>
                            The CSV data will be added or totaly replaced to the current database. If you use FilamentManager-Plugin, these values were not touched.
                        </div>
                        <div>
                            HINT: Before importing a backup file of the database will be automatically created. See Storage-Tab for more details.<!-- <a href="#tab-pjhe-Storage" data-toggle="tab">storage folder</a>. -->
                        </div>
                        <br>
                        <div>
                            Format:
                            <ul>
                                <li>CSV-Delimiter is a comma</li>
                                <li>You need a header row and value rows</li>
                                <li>The order of the columns doesn't matter</li>
                                <li>Use allowed header names for importing values (see below). Other column names will be skipped</li>
                            </ul>
                            Mandatory column names:
                            <ul>
                                <li><code>Print result [success canceled failed]</code></li>
                                <li><code>File Name</code></li>
                                <li><code>Start Datetime [dd.mm.yyyy hh:mm]</code></li>
                                <li><code>Duration</code></li>
                            </ul>
                            <br>
                            Other column names:
                            <ul>
                                <li><code>User</code></li>
                                <li><code>End Datetime [dd.mm.yyyy hh:mm]</code></li>
                                <li><code>File Path</code></li>
                                <li><code>File Size [bytes]</code></li>
                                <li><code>Note</code></li>
                                <li><code>Spool Name</code></li>
                                <li><code>Material</code></li>
                                <li><code>Diameter [mm]</code></li>
                                <li><code>Density [g/cm3]</code></li>
                                <li><code>Used Length [mm]</code></li>
                                <li><code>Calculated Length [mm]</code></li>
                                <li><code>Used Weight [g]</code></li>
                                <li><code>Used Filament Cost</code></li>
                                <li><code>...</code></li>
                            </ul>
                        </div>
                        <div>
                            Download a <a href="#" data-bind="attr: {href: $root.sampleCSVUrl(), css: {disabled: !$root.sampleCSVUrl()}}">sample csv</a> for a full list of all columns
                        </div>


<!--                        <div class="input-prepend">-->
<!--                            <span class="btn fileinput-button">-->
<!--                                <span>Browse...</span>-->
<!--                                <input id="settings-pjhe-importcsv-upload"-->
<!--                                       type="file"-->
<!--                                       name="file"-->
<!--                                       data-url="/plugin/PrintJobHistoryExtended/importCSV"-->
<!--                                       accept=".csv">-->
<!--                            </span>-->
<!--                            <span class="add-on" data-bind="text: csvFileUploadName"></span>-->
<!--                        </div>-->
                    </div>
                </div>
<!--                <div class="control-group">-->
<!--                    <div class="controls">-->
<!--                        <button class="btn btn-primary"-->
<!--                                data-bind="enable: !csvImportInProgress(), click: performCSVImportFromUpload">-->
<!--                            <i class="fa fa-spinner fa-spin"-->
<!--                               data-bind="visible: csvImportInProgress"></i> Upload & import-->
<!--                        </button>-->
<!--                    </div>-->
<!--                </div>-->


            </div>
            <!-- STORAGE - TAB -->
            <div class="tab-pane" id="tab-pjhe-Storage">

                <h4>Migration from Print Job History</h4>
                <div class="control-group">
                    <div class="controls">
                        <span data-bind="visible: legacyMigration.status().available">
                            Copy print jobs, snapshots and settings from a previous
                            <b>PrintJobHistory</b> installation into this plugin.
                            The originals are kept.
                        </span>
                        <span data-bind="visible: !legacyMigration.status().available">
                            No previous PrintJobHistory installation was found.
                        </span>
                        <div style="margin-top:8px">
                            <button class="btn" data-bind="enable: legacyMigration.status().available, click: legacyMigration.showDialog">
                                Open migration dialog&hellip;
                            </button>
                        </div>
                    </div>
                </div>
                <hr/>

                <h4>Instance Name</h4>
                <div class="control-group" >
                    <label class="control-label" >OctoPrint Name</label>
                    <div class="controls">
                        <input type="text" class="input-block-level" data-bind="value: pluginSettings.instanceName">
                        <span class="help-block">The instance name identifies the print jobs of this OctoPrint instance in a shared external database.<br/>
                        <div class="alert">If you change this name, the print jobs already stored under the old name will no longer be shown for this instance. You would have to rename them manually in the database.</div>
                        </span>
                    </div>
                </div>

                <h4>Database Backend</h4>

                <div class="controls">
                    <label class="radio">
                        <input type="radio" name="externalDatabaseGroup" data-bind="checked: pluginSettings.useExternal, checkedValue: false"> Use local SQLite3 database
                    </label>
                    <label class="radio">
                        <input type="radio" name="externalDatabaseGroup" data-bind="checked: pluginSettings.useExternal, checkedValue: true"> Use external database
                    </label>
                    <span class="help-block">You need to save the settings before a change of the backend takes effect.</span>
                </div>

                <h4>Local SQLite3 Database</h4>

                <div class="control-group">
                    <label class="control-label">Database file location</label>
                    <div class="controls">
                        <div class="input-append">
                            <input type="text" disabled class="input-xlarge text-right" data-bind="value: databaseFileLocation"/>
                            <a href="#" class="btn btn-danger" title="ReCreate Database" data-bind="click: deleteDatabaseAction"><i class="icon-trash"></i></a>
                            <a href="#" class="btn btn-primary" title="Download Database" data-bind="attr: {href: downloadDatabaseUrl}, visible: !pluginSettings.useExternal()" target="_blank"><i class="icon-download"></i></a>
                        </div>
                        <span class="help-block" data-bind="visible: pluginSettings.useExternal()">An external database is in use. Back it up with the database server's own tools (e.g. <code>mysqldump</code>).</span>
                    </div>
                </div>
                <div class="control-group">
                    <label class="control-label">Snapshot file location</label>
                    <div class="controls">
                        <input type="text" disabled class="input-xlarge text-right" data-bind="value: snapshotFileLocation"/>
                        <span class="help-block">Snapshot images are always stored as files on this OctoPrint instance. They are never stored in the database and are not shared with other instances.</span>
                    </div>
                </div>
                <div class="control-group">
                    <label class="control-label">Database Backupname</label>
                    <div class="controls">
                        e.g.<code>printJobHistoryExtended-backup-V2-20191207-0924.db</code>
                    </div>
                </div>

                <!-- EXTERNAL DATABASE -->
                <div data-bind="visible: pluginSettings.useExternal()">
                    <h4>External Database</h4>

                    <div class="control-group">
                        <label class="control-label">Type</label>
                        <div class="controls">
                            <select class="input-medium" data-bind="value: pluginSettings.databaseType">
                                <option value="mysql">MySQL / MariaDB</option>
                            </select>
                        </div>
                    </div>
                    <div class="control-group">
                        <label class="control-label">Host</label>
                        <div class="controls">
                            <input type="text" placeholder="e.g. 127.0.0.1" data-bind="value: pluginSettings.databaseHost"/>
                        </div>
                    </div>
                    <div class="control-group">
                        <label class="control-label">Port</label>
                        <div class="controls">
                            <input type="text" placeholder="e.g. 3306" data-bind="value: pluginSettings.databasePort"/>
                        </div>
                    </div>
                    <div class="control-group">
                        <label class="control-label">Database Name</label>
                        <div class="controls">
                            <input type="text" placeholder="name of the existing, empty database" data-bind="value: pluginSettings.databaseName"/>
                        </div>
                    </div>
                    <div class="control-group">
                        <label class="control-label">User</label>
                        <div class="controls">
                            <input type="text" placeholder="database user" data-bind="value: pluginSettings.databaseUser"/>
                        </div>
                    </div>
                    <div class="control-group">
                        <label class="control-label">Password</label>
                        <div class="controls">
                            <input type="password" data-bind="value: pluginSettings.databasePassword"/>
                        </div>
                    </div>

                    <div class="control-group">
                        <div class="controls">
                            <button class="btn btn-info" data-bind="click: testDatabaseConnection, enable: !databaseBusy()">Test connection</button>
                            <button class="btn" data-bind="click: copyDatabaseAction, enable: !databaseBusy()" title="Copy all print jobs from the local SQLite database to the external database">Copy local data to external database</button>
                            <button class="btn btn-warning" data-bind="click: upgradeDatabaseSchemeAction, enable: !databaseBusy(), visible: databaseSchemeUpgradeNeeded()" title="Run the pending database scheme migration">Upgrade database scheme</button>
                        </div>
                    </div>
                    <div class="control-group" data-bind="visible: databaseSchemeUpgradeNeeded()">
                        <div class="controls">
                            <div class="alert">The external database needs a scheme upgrade. It is not done automatically, because several OctoPrint instances may share this database. Make sure the other instances are not writing to it, then press "Upgrade database scheme".</div>
                        </div>
                    </div>
                </div>

                <div class="control-group">
                    <div class="controls">
                        <span data-bind="text: databaseConnectionTestResult, css: {'text-error': !databaseConnectionTestSuccess(), 'text-success': databaseConnectionTestSuccess()}"></span>
                    </div>
                </div>

                <h4>Database scheme</h4>
                <div class="control-group">
                    <div class="controls">
                        <table class="table table-condensed table-hover">
                            <thead>
                                <tr><th></th><th>Scheme version</th><th>Print jobs</th></tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Local SQLite</td>
                                    <td data-bind="text: databaseLocalSchemeVersion"></td>
                                    <td data-bind="text: databaseLocalJobCount"></td>
                                </tr>
                                <tr data-bind="visible: pluginSettings.useExternal()">
                                    <td>External</td>
                                    <td data-bind="text: databaseExternalSchemeVersion"></td>
                                    <td data-bind="text: databaseExternalJobCount"></td>
                                </tr>
                            </tbody>
                        </table>
                        <span class="help-block">Scheme version required by this plugin version: <span data-bind="text: databaseSchemeVersionFromPlugin"></span></span>
                    </div>
                </div>

            </div>

            <!-- DEBUGGING - TAB -->
            <div class="tab-pane" id="tab-pjhe-Debugging">
                <div class="control-group">
                    <div class="controls">
                        <label class="checkbox">
                            <input type="checkbox" data-bind="checked: pluginSettings.sqlLoggingEnabled" > SQL Logging enabled
                        </label>
                        <span class="help-inline">Hint: You need to restart your server after you changed the checkbox value.</span>
                    </div>
                </div>
            </div>

        </div>
    </div>

</form>


